{
  "name": "cancer-detection-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "go run ./backend-go/cmd/server",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:arch": "powershell -ExecutionPolicy Bypass -File scripts/check-frontend-architecture-boundary.ps1",
    "backfill:regions224": "node scripts/backfill-legacy-224-regions.js",
    "repair:uploads": "node scripts/repair-missing-upload-files.js",
    "train:best": "powershell -ExecutionPolicy Bypass -File ai-service/scripts/train_best.ps1",
    "train:best:cpu": "powershell -ExecutionPolicy Bypass -File ai-service/scripts/train_best.ps1 -AllowCpu",
    "ai:validate": "python ai-service/scripts/run_validation_pipeline.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.4.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
